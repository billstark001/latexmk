{
  "name": "@latexmk/deploy",
  "version": "0.2.0",
  "private": true,
  "bin": {
    "latexmk-deploy": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "test": "pnpm build && node --test test/*.test.mjs",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware src test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
